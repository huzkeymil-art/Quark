# Copy this file to ".env" and fill in your own values.
# Never commit the real .env -- it holds your password.

# --- Blackbaud / myschoolapp portal ---
SCHOOL_USERNAME=you@example.com
SCHOOL_PASSWORD=your-portal-password

# Optional: only needed if your school uses a different subdomain.
# SCHOOL_BASE_URL=https://battlegroundacademy.myschoolapp.com

# Optional: paste your browser's address bar from the Assignment Center if the
# script can't find the page on its own.
# ASSIGNMENT_CENTER_URL=https://battlegroundacademy.myschoolapp.com/lms-assignment/assignment-center/student?svcid=edu

# --- Notion ---
# Create an integration at https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The 32-character ID from your database URL. Pasting the whole URL also works.
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
